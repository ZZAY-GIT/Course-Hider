{
  "manifest_version": 3,
  "name": "Course Hider - Мосполитех",
  "version": "1.1",
  "description": "Позволяет выбирать и скрывать ненужные курсы в личном кабинете Мосполитеха",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://online.mospolytech.ru/my/*",
        "https://online.mospolytech.ru/course/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}